# X / Twitter app credentials — https://developer.x.com/en/portal/dashboard
# The app needs Read and Write permissions, and the tokens must be regenerated
# after changing permissions.
API_KEY=
API_SECRET=
ACCESS_TOKEN=
ACCESS_TOKEN_SECRET=

# Optional: https://unsplash.com/developers
# Without it the bot draws a solid colour background instead of a photo.
UNSPLASH_API_KEY=

# Scheduling: the container posts at POST_AT in this timezone, every day.
TZ=Africa/Cairo
POST_AT=08:00

# Optional tuning
IMAGE_QUERY=mountains lake nature
# FONT_PATH=/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf
# OUTPUT_PATH=images/output_image.jpg
# QUOTES_FILE=data/quotes.json
# Fetch quotes from a remote API, falling back to the bundled dataset.
# QUOTE_API_URL=
# Post the quote without the image if media upload fails. Set false to make a
# failed upload abort the post instead.
# ALLOW_TEXT_ONLY=true
# Alternative to POST_AT: post every N seconds rather than at a set time.
# POST_INTERVAL_SECONDS=86400

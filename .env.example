# X / Twitter app credentials — https://developer.x.com/en/portal/dashboard
# The app needs Read and Write permissions, and the tokens must be regenerated
# after changing permissions.
API_KEY=
API_SECRET=
ACCESS_TOKEN=
ACCESS_TOKEN_SECRET=

# Optional: https://unsplash.com/developers
# Without it the bot draws a solid colour background instead of a photo.
UNSPLASH_API_KEY=

# Optional tuning
IMAGE_QUERY=mountains lake nature
# FONT_PATH=/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf
# OUTPUT_PATH=images/output_image.jpg
# Set to keep the process running and post on an interval (seconds).
# POST_INTERVAL_SECONDS=86400

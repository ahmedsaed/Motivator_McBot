# OAuth 2.0 (preferred). Create the App at https://console.x.com with type
# "Automated App or Bot", then run scripts/authorize.py for the refresh token.
# Access tokens expire after two hours, so the bot refreshes on every run.
CLIENT_ID=
CLIENT_SECRET=
REFRESH_TOKEN=

# OAuth 1.0a (legacy). Only used when the OAuth 2.0 values above are empty.
# API_KEY=
# API_SECRET=
# ACCESS_TOKEN=
# ACCESS_TOKEN_SECRET=

# Optional: https://unsplash.com/developers
# Without it the bot draws a solid colour background instead of a photo.
UNSPLASH_API_KEY=

# Scheduling: the container posts at POST_AT in this timezone, every day.
TZ=Africa/Cairo
POST_AT=08:00

# Optional tuning
IMAGE_QUERY=mountains lake nature
# FONT_PATH=/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf
# OUTPUT_PATH=images/output_image.jpg
# QUOTES_FILE=data/quotes.json
# Where the rotated refresh token is kept; must be writable.
# TOKEN_STORE=state/token.json
# Fetch quotes from a remote API, falling back to the bundled dataset.
# QUOTE_API_URL=
# Alternative to POST_AT: post every N seconds rather than at a set time.
# POST_INTERVAL_SECONDS=86400
